# ── AI-chat (Vercel serverless: /api/chat) ──────────────────────────
# Samma variabel som i portfolio-klas – återanvänd din befintliga nyckel.
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ── Kontaktformulär (Vercel serverless: /api/contact) ───────────────
# Gmail med app-lösenord, samma som i portfolio-klas.
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-specific-password

# Utan dessa variabler fungerar sajten ändå:
#  - chatten faller tillbaka på den inbyggda offline-konstruktionen
#  - kontaktformuläret faller tillbaka på en förifylld mailto-länk
